<!DOCTYPE html>  
<html lang="bn">  
<head>  
  <meta charset="UTF-8">  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">  
  <title>SR CALCULATOR</title>  
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600&display=swap" rel="stylesheet">  
  <style>  
    :root {  
      --bg-color: #1e1e2f;  
      --main-color: #0fffc1;  
      --text-color: #ffffff;  
      --glass: rgba(255, 255, 255, 0.1);  
    }  
    * {  
      margin: 0;  
      padding: 0;  
      box-sizing: border-box;  
      font-family: 'Poppins', sans-serif;  
    }  
    body {
      background: linear-gradient(135deg, #1e1e2f, #2c2c3e);
      color: var(--text-color);
      overflow-x: hidden;
    }
    header {
      padding: 1rem;
      text-align: center;
      background: linear-gradient(to right, #0fffc1, #00d4ff);
      -webkit-background-clip: text;
      color: transparent;
      font-size: 2rem;
      font-weight: 600;
    }
    .menu-btn {
      position: absolute;
      top: 1rem;
      left: 1rem;
      font-size: 1.8rem;
      cursor: pointer;
      z-index: 1000;
    }
    .menu-panel {
      position: fixed;
      top: 0;
      left: -300px;
      width: 300px;
      height: 100vh;
      background: var(--glass);
      backdrop-filter: blur(12px);
      transition: left 0.3s ease;
      padding: 2rem 1rem;
      z-index: 999;
    }
    .menu-panel.active {
      left: 0;
    }
    .menu-panel h3 {
      margin-bottom: 1.5rem;
      text-align: center;
      font-weight: 600;
      font-size: 1.2rem;
    }
    .menu-panel ul {
      list-style: none;
    }
    .menu-panel li {
      padding: 1rem;
      cursor: pointer;
      border-bottom: 1px solid #555;
    }
    .calculator {
      width: 100%;
      max-width: 400px;
      margin: 2rem auto;
      padding: 1rem;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }
    .display {
      width: 100%;
      background: rgba(0, 0, 0, 0.2);
      padding: 1rem;
      font-size: 2rem;
      border-radius: 10px;
      margin-bottom: 1rem;
      text-align: right;
      color: var(--text-color);
    }
    .buttons {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    button {
      padding: 1rem;
      font-size: 1.2rem;
      border: none;
      border-radius: 12px;
      background: var(--main-color);
      color: #000;
      font-weight: bold;
      transition: 0.3s;
    }
    button:hover {
      background: #00ffc3;
      transform: scale(1.05);
    }
    .history {
      max-height: 150px;
      overflow-y: auto;
      margin-top: 1rem;
      font-size: 0.9rem;
      padding: 0.5rem;
      border-top: 1px solid #555;
    }
    .footer {
      margin-top: 2rem;
      text-align: center;
      font-size: 0.9rem;
    }
    .footer a {
      color: #0fffc1;
      text-decoration: none;
    }
    .footer a:hover {
      text-decoration: underline;
    }
  </style>  
</head>  
<body>  
  <div class="menu-btn" onclick="toggleMenu()">≡</div>  
  <header>SR CALCULATOR</header>  
  <div class="menu-panel" id="menu">  
    <h3>মেনু</h3>  
    <ul>  
      <li onclick="alert('Standard Calculator Selected')">Standard Calculator</li>  
      <li onclick="alert('Scientific Calculator Selected')">Scientific Calculator</li>  
      <li onclick="alert('Standard History')">History (Standard)</li>  
      <li onclick="alert('Scientific History')">History (Scientific)</li>  
      <li onclick="window.open('https://t.me/rahat8475')">Contact Developer</li>  
      <li onclick="alert('SR Calculator: Developed by Samaduzzaman Rahat')">About</li>  
      <li onclick="exitApp()">Exit App</li>  
    </ul>  
  </div>  
  <div class="calculator">  
    <div class="display" id="display">0</div>  
    <div class="buttons">  
      <button onclick="append('7')">7</button>  
      <button onclick="append('8')">8</button>  
      <button onclick="append('9')">9</button>  
      <button onclick="operate('/')">÷</button>  
      <button onclick="append('4')">4</button>  
      <button onclick="append('5')">5</button>  
      <button onclick="append('6')">6</button>  
      <button onclick="operate('*')">×</button>  
      <button onclick="append('1')">1</button>  
      <button onclick="append('2')">2</button>  
      <button onclick="append('3')">3</button>  
      <button onclick="operate('-')">−</button>  
      <button onclick="append('0')">0</button>  
      <button onclick="append('.')">.</button>  
      <button onclick="calculate()">=</button>  
      <button onclick="operate('+')">+</button>  
      <button onclick="clearDisplay()">C</button>  
      <button onclick="backspace()">⌫</button>  
    </div>  
    <div class="history" id="history"></div>  
  </div>  
  <div class="footer">  
    Developer & Founder: Samaduzzaman Rahat<br>  
    <a href="https://t.me/rahat8475" target="_blank">Contact Us - Telegram</a>  
  </div>  
  <script>  
    let display = document.getElementById('display');  
    let historyDiv = document.getElementById('history');  
    let current = '';  
    function toggleMenu() {  
      document.getElementById('menu').classList.toggle('active');  
    }  
    function append(char) {  
      if (display.innerText === '0') display.innerText = '';  
      display.innerText += char;  
    }  
    function operate(op) {  
      display.innerText += ' ' + op + ' ';  
    }  
    function calculate() {  
      try {  
        let result = eval(display.innerText);  
        historyDiv.innerHTML += `<div>${display.innerText} = <b>${result}</b></div>`;  
        display.innerText = result;  
      } catch (e) {  
        display.innerText = 'Error';  
      }  
    }  
    function clearDisplay() {  
      display.innerText = '0';  
    }  
    function backspace() {  
      display.innerText = display.innerText.slice(0, -1);  
      if (display.innerText === '') display.innerText = '0';  
    }  
    function exitApp() {  
      if (confirm('আপনি কি অ্যাপ থেকে বের হতে চান?')) {  
        window.close();  
      }  
    }

    // ADDITIONAL SCRIPT TO MAKE MENU FUNCTIONAL
    document.querySelectorAll('.menu-panel li').forEach((item) => {
      item.addEventListener('click', () => {
        document.getElementById('menu').classList.remove('active');
      });
    });
  </script>  
</body>  
</html>
